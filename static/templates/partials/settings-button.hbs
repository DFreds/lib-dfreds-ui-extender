<fieldset>
    <legend><i class="{{settingsButton.icon}}"></i>
        {{localize settingsButton.name}}</legend>

    <div class="form-group">
        <label>{{localize
                "UiExtender.RegistrationConfig.SettingsButton.ModuleIdLabel"
            }}</label>
        <div class="form-fields">
            <input type="text" value="{{settingsButton.moduleId}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize
                "UiExtender.RegistrationConfig.SettingsButton.NameLabel"
            }}</label>
        <div class="form-fields">
            <input type="text" value="{{localize settingsButton.name}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize
                "UiExtender.RegistrationConfig.SettingsButton.IconLabel"
            }}</label>
        <div class="form-fields">
            <input type="text" value="{{settingsButton.icon}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize
                "UiExtender.RegistrationConfig.SettingsButton.GmOnlyLabel"
            }}</label>
        <div class="form-fields">
            <input
                type="text"
                value="{{#if settingsButton.gmOnly}}{{localize "COMMON.Yes"}}{{else}}{{localize "COMMON.No"}}{{/if}}"
                disabled
            />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize
                "UiExtender.RegistrationConfig.SettingsButton.ApplicationClassLabel"
            }}</label>
        <div class="form-fields">
            <input
                type="text"
                value="{{settingsButton.applicationClass.name}}"
                disabled
            />
        </div>
    </div>
</fieldset>
