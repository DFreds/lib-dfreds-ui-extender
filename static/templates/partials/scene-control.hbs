<fieldset>
    <legend><i class="{{sceneControl.control.icon}}"></i> {{localize sceneControl.control.title}}</legend>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.ModuleIdLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{sceneControl.moduleId}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.NameLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{sceneControl.control.name}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.TitleLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{localize sceneControl.control.title}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.IconLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{sceneControl.control.icon}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.LayerLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{sceneControl.control.layer}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.OrderLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{sceneControl.control.order}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.BeforeLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{sceneControl.before}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.AfterLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{sceneControl.after}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.GmOnlyLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{#if sceneControl.gmOnly}}{{localize "COMMON.Yes"}}{{else}}{{localize "COMMON.No"}}{{/if}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.PredicateLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{#if (ne sceneControl.predicate undefined)}}{{localize "COMMON.Yes"}}{{else}}{{localize "COMMON.No"}}{{/if}}" disabled />
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "UiExtender.RegistrationConfig.SceneControl.ToolsLabel"}}</label>
        <div class="form-fields">
            <input type="text" value="{{#each sceneControl.control.tools as |tool|}}{{tool.name}}{{#unless @last}}, {{/unless}}{{/each}}" disabled />
        </div>
    </div>
</fieldset>
